# Google Gemini API Key (Ditetapkan di Serverless Environment / Vercel Environment Variables: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive OAuth Client ID (Dapatkan di Google Cloud Console: https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Unsplash API Access Key (Dapatkan di Unsplash Developers: https://unsplash.com/developers)
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
